---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import RubricaGrid from '../components/RubricaGrid.astro';
import NewsletterSection from '../components/NewsletterSection.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredPost = sortedPosts[0];
const latestPosts = sortedPosts.slice(0, 6);

const allGlossario = await getCollection('glossario');
const featuredGlossario = allGlossario.slice(0, 3);

const verdeRubriche = ['TRAME DI STORIA', 'DALLA FILIERA'];
const featuredIsVerde = featuredPost ? verdeRubriche.includes(featuredPost.data.rubrica) : false;
---

<BaseLayout title="TRAMA Studio" description="Divulgazione sulla cultura tessile. Materiali, filiere, storia dei tessuti, etichette e qualità con rigore e autorevolezza.">

  <!-- BLOCCO 1 — Hero -->
  <section class="bg-nero text-bianco py-24 md:py-36 px-6 md:px-10">
    <div class="max-w-content mx-auto">
      <p class="occhiello text-terracotta mb-8">Divulgazione tessile</p>
      <h1 class="text-bianco mb-6 max-w-3xl" style="font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: clamp(40px, 6vw, 64px); line-height: 1.05; letter-spacing: -0.02em;">
        Il linguaggio nascosto dei tessuti
      </h1>
      <p class="max-w-xl" style="font-family: 'Cormorant Garamond', serif; font-weight: 300; font-style: italic; font-size: 20px; line-height: 1.6; color: #D8C7B8;">
        Materiali, cultura, consapevolezza.
      </p>
      <div class="mt-10">
        <a
          href="/blog"
          class="occhiello text-bianco border border-bianco px-5 py-3 hover:bg-bianco hover:text-nero transition-colors duration-200"
          style="font-size: 11px;"
        >
          Esplora i materiali
        </a>
      </div>
    </div>
  </section>

  <!-- BLOCCO 2 — Articolo in evidenza -->
  {featuredPost && (
    <section style="background-color: #F5F1EA; border-top: 0.5px solid #D8C7B8; border-bottom: 0.5px solid #D8C7B8;">
      <div class="max-w-content mx-auto px-6 md:px-10 py-16 md:py-20">
        <p class="occhiello text-grigio mb-8">In evidenza</p>
        <div class="flex flex-col md:flex-row gap-10 md:gap-16 items-start">
          <div class="md:w-1/4 flex-shrink-0">
            <span class={`occhiello block ${featuredIsVerde ? 'text-verde' : 'text-terracotta'}`}>
              {featuredPost.data.rubrica}
            </span>
          </div>
          <div class="md:flex-1">
            <h2 style="font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: clamp(28px, 4vw, 44px); line-height: 1.1; letter-spacing: -0.015em; color: #111111; margin-bottom: 1rem;">
              {featuredPost.data.title}
            </h2>
            <p style="font-family: 'Cormorant Garamond', serif; font-weight: 300; font-style: italic; font-size: 18px; line-height: 1.6; color: #5C4033; margin-bottom: 1.5rem; max-width: 60ch;">
              {featuredPost.data.lead}
            </p>
            <a
              href={`/blog/${featuredPost.slug}`}
              class="occhiello text-terracotta hover:underline underline-offset-2"
              style="font-size: 11px;"
            >
              Leggi →
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- BLOCCO 3 — Le rubriche -->
  <section class="py-20 px-6 md:px-10">
    <div class="max-w-content mx-auto mb-12">
      <p class="occhiello text-grigio mb-2">Cosa trovi su TRAMA</p>
      <h2 style="font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 32px; letter-spacing: -0.01em; line-height: 1.2;">Le rubriche</h2>
    </div>
  </section>

  <div class="max-w-content mx-auto px-6 md:px-10 pb-20">
    <RubricaGrid />
  </div>

  <hr class="separator mx-6 md:mx-10" />

  <!-- BLOCCO 4 — Ultimi articoli -->
  <section class="py-20 px-6 md:px-10">
    <div class="max-w-content mx-auto">
      <div class="flex items-baseline justify-between mb-12">
        <div>
          <p class="occhiello text-grigio mb-2">Dal blog</p>
          <h2 style="font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 32px; letter-spacing: -0.01em; line-height: 1.2;">Ultimi articoli</h2>
        </div>
        <a href="/blog" class="occhiello text-terracotta hover:underline underline-offset-2 hidden md:block" style="font-size: 10px;">
          Tutti gli articoli →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12">
        {latestPosts.map(post => (
          <ArticleCard
            title={post.data.title}
            rubrica={post.data.rubrica}
            lead={post.data.lead}
            date={post.data.date}
            slug={post.slug}
          />
        ))}
      </div>

      <div class="mt-10 md:hidden">
        <a href="/blog" class="occhiello text-terracotta hover:underline underline-offset-2" style="font-size: 10px;">
          Tutti gli articoli →
        </a>
      </div>
    </div>
  </section>

  <!-- BLOCCO 5 — Newsletter -->
  <NewsletterSection />

  <!-- BLOCCO 6 — Glossario in evidenza -->
  <section style="background-color: #F5F1EA; border-top: 0.5px solid #D8C7B8;" class="py-20 px-6 md:px-10">
    <div class="max-w-content mx-auto">
      <div class="flex items-baseline justify-between mb-12">
        <div>
          <p class="occhiello text-grigio mb-2">Per capire meglio</p>
          <h2 style="font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 32px; letter-spacing: -0.01em; line-height: 1.2;">Glossario Tessile</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px" style="background-color: #D8C7B8;">
        {featuredGlossario.map(voce => (
          <div class="bg-bianco px-6 py-8" style="background-color: #F5F1EA;">
            <h3 style="font-family: 'Cormorant Garamond', serif; font-weight: 600; font-size: 22px; color: #111111; margin-bottom: 0.75rem; line-height: 1.2;">
              {voce.data.termine}
            </h3>
            <p style="font-family: 'Inter', sans-serif; font-weight: 400; font-size: 14px; line-height: 1.7; color: #5C4033; max-width: none;">
              {voce.data.definizione}
            </p>
          </div>
        ))}
      </div>

      <div class="mt-10">
        <a
          href="/glossario"
          class="occhiello text-terracotta hover:underline underline-offset-2"
          style="font-size: 11px;"
        >
          Consulta il glossario completo →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
