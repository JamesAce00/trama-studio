---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const verdeRubriche = ['TRAME DI STORIA', 'DALLA FILIERA'];
const isVerde = verdeRubriche.includes(post.data.rubrica);

const wordCount = post.body.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BaseLayout title={post.data.title} description={post.data.lead}>

  <article>
    <!-- Back link -->
    <div class="px-6 md:px-10 pt-10 pb-6">
      <div class="max-w-content mx-auto">
        <a
          href="/blog"
          class="didascalia text-grigio hover:text-terracotta transition-colors"
          style="letter-spacing: 0.04em;"
        >
          ← Torna al blog
        </a>
      </div>
    </div>

    <!-- Header articolo -->
    <header class="px-6 md:px-10 pb-12 border-b" style="border-color: #D8C7B8; border-width: 0.5px;">
      <div class="max-w-editorial mx-auto">
        <span class={`occhiello block mb-4 ${isVerde ? 'text-verde' : 'text-terracotta'}`}>
          {post.data.rubrica}
        </span>

        <h1 class="text-nero mb-6">
          {post.data.title}
        </h1>

        <div class="flex items-center gap-4 mb-8">
          <span class="didascalia">Tempo di lettura: {readingTime} min</span>
          {post.data.autore && (
            <>
              <span class="didascalia" style="color: #D8C7B8;">—</span>
              <span class="didascalia">{post.data.autore}</span>
            </>
          )}
        </div>

        <p class="lead-text">
          {post.data.lead}
        </p>
      </div>
    </header>

    <!-- Corpo articolo -->
    <div class="px-6 md:px-10 py-14">
      <div class="max-w-editorial mx-auto prose-editorial">
        <Content />
      </div>
    </div>

    <!-- Footer articolo -->
    <footer class="px-6 md:px-10 py-10 border-t" style="border-color: #D8C7B8; border-width: 0.5px;">
      <div class="max-w-editorial mx-auto flex justify-between items-center">
        <a
          href="/blog"
          class="occhiello text-grigio hover:text-terracotta transition-colors"
          style="font-size: 10px;"
        >
          ← Tutti gli articoli
        </a>
        <span class={`occhiello ${isVerde ? 'text-verde' : 'text-terracotta'}`} style="font-size: 10px;">
          {post.data.rubrica}
        </span>
      </div>
    </footer>
  </article>

  <!-- Newsletter block -->
  <section style="background-color: #111111;" class="py-16 px-6 md:px-10">
    <div class="max-w-editorial mx-auto">
      <p
        style="font-family: 'Cormorant Garamond', serif; font-weight: 300; font-style: italic; font-size: 22px; line-height: 1.4; color: #D8C7B8; margin-bottom: 1.75rem;"
      >
        Ti è piaciuto questo articolo? Iscriviti alla newsletter.
      </p>
      <form class="flex flex-col sm:flex-row gap-3 max-w-md" onsubmit="return false;">
        <input
          type="email"
          placeholder="La tua email"
          required
          style="flex: 1; padding: 12px 16px; background: transparent; border: 0.5px solid #A9A29A; color: #F5F1EA; font-family: 'Inter', sans-serif; font-size: 14px; outline: none; transition: border-color 0.2s;"
          onfocus="this.style.borderColor='#A65A3A'"
          onblur="this.style.borderColor='#A9A29A'"
        />
        <button
          type="submit"
          class="occhiello transition-colors duration-200 hover:opacity-90"
          style="padding: 12px 24px; background-color: #A65A3A; color: #F5F1EA; font-size: 11px; white-space: nowrap; border: none; cursor: pointer;"
        >
          Iscriviti
        </button>
      </form>
    </div>
  </section>

</BaseLayout>
