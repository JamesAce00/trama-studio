---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NewsletterSection from '../../components/NewsletterSection.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const rubriche = [
  'TUTTE',
  'MATERIA PRIMA',
  'DENTRO IL CAPO',
  "DIETRO L'ETICHETTA",
  'MITI DA SFATARE',
  'GLOSSARIO TESSILE',
  'SCELTE CONSAPEVOLI',
  'TRAME DI STORIA',
  'DALLA FILIERA',
];
---

<BaseLayout title="Blog" description="Tutti gli articoli di TRAMA Studio sulla cultura tessile.">

  <section class="py-16 px-6 md:px-10 border-b" style="border-color: #D8C7B8; border-width: 0.5px;">
    <div class="max-w-content mx-auto">
      <p class="occhiello text-grigio mb-3">Archivio</p>
      <h1 style="font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: clamp(36px, 5vw, 52px); line-height: 1.08; letter-spacing: -0.015em;">
        Il blog
      </h1>
      <p class="lead-text mt-4 max-w-lg">
        Tutti gli articoli di TRAMA Studio, ordinati per data di pubblicazione.
      </p>
    </div>
  </section>

  <!-- Filtro rubriche -->
  <section id="rubriche" class="py-6 px-6 md:px-10 border-b overflow-x-auto" style="border-color: #D8C7B8; border-width: 0.5px;">
    <div class="max-w-content mx-auto">
      <div class="flex gap-3 flex-nowrap md:flex-wrap" id="filter-container">
        {rubriche.map((r, i) => {
          const isVerde = r === 'TRAME DI STORIA' || r === 'DALLA FILIERA';
          return (
            <button
              class={`filter-btn occhiello whitespace-nowrap px-4 py-2 border transition-colors duration-200 ${
                i === 0
                  ? 'bg-nero text-bianco border-nero'
                  : 'bg-transparent text-grigio border-sabbia hover:border-nero hover:text-nero'
              }`}
              style={`font-size: 10px; ${isVerde ? '--accent: #2D5A27' : '--accent: #A65A3A'}`}
              data-rubrica={r}
            >
              {r}
            </button>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Articoli -->
  <section class="py-4 px-6 md:px-10">
    <div class="max-w-content mx-auto">
      <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 gap-x-16">
        {sortedPosts.map(post => (
          <div class="article-item" data-rubrica={post.data.rubrica}>
            <ArticleCard
              title={post.data.title}
              rubrica={post.data.rubrica}
              lead={post.data.lead}
              date={post.data.date}
              slug={post.slug}
            />
          </div>
        ))}
      </div>

      <div id="no-results" class="hidden py-20 text-center">
        <p class="didascalia">Nessun articolo in questa rubrica per ora.</p>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <NewsletterSection />

</BaseLayout>

<script is:inline>
(function(){
  var buttons = document.querySelectorAll('.filter-btn');
  var items = document.querySelectorAll('.article-item');
  var noResults = document.getElementById('no-results');
  buttons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var selected = btn.getAttribute('data-rubrica') || 'TUTTE';
      buttons.forEach(function(b) {
        b.classList.remove('bg-nero','text-bianco','border-nero');
        b.classList.add('bg-transparent','text-grigio','border-sabbia');
      });
      btn.classList.remove('bg-transparent','text-grigio','border-sabbia');
      btn.classList.add('bg-nero','text-bianco','border-nero');
      var visible = 0;
      items.forEach(function(item) {
        if(selected==='TUTTE'||item.getAttribute('data-rubrica')===selected){item.style.display='';visible++;}
        else{item.style.display='none';}
      });
      if(noResults)noResults.classList.toggle('hidden',visible>0);
    });
  });
})();
</script>
