---
import BaseLayout from '../layouts/BaseLayout.astro';

const principi = [
  {
    numero: '01',
    titolo: 'La consapevolezza viene prima del giudizio',
    testo: 'Non diciamo cosa è giusto o sbagliato comprare. Forniamo gli strumenti per capire, perché la scelta informata ha un valore in sé, indipendente dal risultato.',
  },
  {
    numero: '02',
    titolo: 'Il tessile è cultura, non solo prodotto',
    testo: 'Un tessuto racconta una storia geografica, economica, artigianale. Capire un materiale significa capire un pezzo di mondo — il lavoro di chi l\'ha prodotto, il territorio in cui è cresciuto.',
  },
  {
    numero: '03',
    titolo: 'La qualità non è uno slogan',
    testo: 'Usiamo questa parola con precisione. La qualità ha parametri misurabili: il diametro di una fibra, la densità di un tessuto, i passaggi di un finissaggio. Non è un\'opinione, è una competenza.',
  },
];

const rubriche = [
  { nome: 'MATERIA PRIMA', verde: false, descrizione: 'Le fibre al centro. Cotone, lana, lino, seta, sintetici: da dove vengono, come si producono, cosa significano sul corpo.' },
  { nome: 'DENTRO IL CAPO', verde: false, descrizione: 'Anatomia di un indumento. Costruzione, cuciture, fodere, rifiniture: tutto ciò che non si vede ma si sente.' },
  { nome: "DIETRO L'ETICHETTA", verde: false, descrizione: 'Cosa c\'è scritto davvero su quel cartellino. Composizioni, certificazioni, paesi di produzione: imparare a leggere.' },
  { nome: 'MITI DA SFATARE', verde: false, descrizione: 'Le credenze più diffuse sul tessile, smontate con rigore. Il cotone sempre traspirante, la lana che punge, il naturale sempre meglio.' },
  { nome: 'GLOSSARIO TESSILE', verde: false, descrizione: 'Un vocabolario per capire. Termini tecnici spiegati senza semplificazioni eccessive, con contesto e precisione.' },
  { nome: 'SCELTE CONSAPEVOLI', verde: false, descrizione: 'Come orientarsi negli acquisti con più criterio. Non greenwashing, non moralismo: strumenti concreti per decidere meglio.' },
  { nome: 'TRAME DI STORIA', verde: true, descrizione: 'I tessuti come documenti storici. Commercio, potere, cultura e identità raccontati attraverso i fili.' },
  { nome: 'DALLA FILIERA', verde: true, descrizione: 'Dentro i distretti, le manifatture, le aziende che fanno davvero i tessuti. Storie di luoghi e processi.' },
];
---

<BaseLayout
  title="About"
  description="Chi è TRAMA Studio e qual è la sua missione editoriale sulla cultura tessile."
>

  <!-- Header -->
  <section class="py-16 px-6 md:px-10 border-b" style="border-color: #D8C7B8; border-width: 0.5px;">
    <div class="max-w-content mx-auto">
      <p class="occhiello text-grigio mb-3">Chi siamo</p>
      <h1 style="font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: clamp(36px, 5vw, 52px); line-height: 1.08; letter-spacing: -0.015em;">
        Un osservatorio culturale sul tessile
      </h1>
    </div>
  </section>

  <!-- Manifesto -->
  <section class="py-16 px-6 md:px-10 border-b" style="border-color: #D8C7B8; border-width: 0.5px;">
    <div class="max-w-editorial mx-auto">
      <p class="lead-text">
        TRAMA Studio nasce per raccontare ciò che spesso nei vestiti non si vede, ma si sente: il materiale, la struttura, la qualità, la storia, il lavoro.
      </p>
      <p class="lead-text mt-6">
        In un'epoca in cui il fast fashion ha separato il consumatore dalla filiera, e in cui le etichette sono diventate documenti illeggibili o volutamente opachi, crediamo che la conoscenza sia lo strumento più potente per fare scelte migliori.
      </p>
    </div>
  </section>

  <!-- Filosofia -->
  <section class="py-16 px-6 md:px-10 border-b" style="border-color: #D8C7B8; border-width: 0.5px;">
    <div class="max-w-content mx-auto">
      <p class="occhiello text-grigio mb-10">La nostra filosofia</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px" style="background-color: #D8C7B8;">
        {principi.map(p => (
          <div class="px-8 py-10" style="background-color: #F5F1EA;">
            <span class="occhiello text-terracotta block mb-4">{p.numero}</span>
            <h3 style="font-family: 'Cormorant Garamond', serif; font-weight: 600; font-size: 20px; line-height: 1.3; color: #111111; margin-bottom: 1rem;">
              {p.titolo}
            </h3>
            <p style="font-family: 'Inter', sans-serif; font-size: 14px; line-height: 1.75; color: #5C4033; max-width: none;">
              {p.testo}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Rubriche -->
  <section class="py-16 px-6 md:px-10 border-b" style="border-color: #D8C7B8; border-width: 0.5px;">
    <div class="max-w-content mx-auto">
      <p class="occhiello text-grigio mb-10">Le otto rubriche</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0" style="border: 0.5px solid #D8C7B8;">
        {rubriche.map((r, i) => (
          <div
            class="px-8 py-7"
            style={`border-right: ${i % 2 === 0 ? '0.5px solid #D8C7B8' : 'none'}; border-bottom: ${i < rubriche.length - 2 ? '0.5px solid #D8C7B8' : 'none'};`}
          >
            <span class={`occhiello block mb-2 ${r.verde ? 'text-verde' : 'text-terracotta'}`}>
              {r.nome}
            </span>
            <p style="font-family: 'Inter', sans-serif; font-size: 13px; line-height: 1.65; color: #A9A29A; max-width: none;">
              {r.descrizione}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contatti -->
  <section class="py-16 px-6 md:px-10">
    <div class="max-w-editorial mx-auto">
      <p class="occhiello text-grigio mb-4">Contatti</p>
      <p style="font-family: 'Inter', sans-serif; font-size: 15px; line-height: 1.75; color: #5C4033;">
        Per collaborazioni editoriali, segnalazioni o domande:<br />
        <a href="mailto:info@tramastudio.media" class="text-terracotta hover:underline underline-offset-2" style="font-weight: 500;">
          info@tramastudio.media
        </a>
      </p>
    </div>
  </section>

</BaseLayout>
