---
interface Props {
  title: string;
  rubrica: string;
  lead: string;
  date: Date;
  slug: string;
}

const { title, rubrica, lead, slug } = Astro.props;

const verdeRubriche = ['TRAME DI STORIA', 'DALLA FILIERA'];
const isVerde = verdeRubriche.includes(rubrica);
---

<article class="card-hover group px-6 py-6 border-b" style="border-color: #D8C7B8; border-width: 0.5px;">
  <a href={`/blog/${slug}`} class="block">
    <span
      class={`occhiello ${isVerde ? 'rubrica-verde' : 'rubrica-terracotta'} block mb-3`}
    >
      {rubrica}
    </span>

    <h3 class="card-title font-cormorant font-light text-nero transition-colors duration-200 mb-3" style="font-size: 22px; line-height: 1.3; letter-spacing: -0.01em; font-family: 'Cormorant Garamond', serif; font-weight: 600;">
      {title}
    </h3>

    <p class="lead-text text-sm mb-4" style="font-size: 16px; font-family: 'Cormorant Garamond', serif; font-weight: 300; font-style: italic; color: #5C4033; line-height: 1.5;">
      {lead}
    </p>

    <div class="flex items-center justify-end">
      <span class="occhiello text-terracotta group-hover:underline underline-offset-2" style="font-size: 10px; letter-spacing: 0.12em;">
        Leggi →
      </span>
    </div>
  </a>
</article>
