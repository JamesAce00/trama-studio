---
const navLinks = [
  { href: '/blog', label: 'Blog' },
  { href: '/blog#rubriche', label: 'Rubriche' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-bianco border-b" style="border-color: #D8C7B8; border-width: 0.5px;">
  <div class="max-w-content mx-auto px-6 md:px-10 flex items-center justify-between h-16">
    <a href="/" class="flex flex-col leading-none group" aria-label="TRAMA Studio — Homepage">
      <span class="logo-trama text-xl text-nero group-hover:text-terracotta transition-colors duration-200">TRAMA</span>
      <span class="logo-studio text-[9px] mt-[1px]">studio</span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`font-inter font-400 text-sm tracking-wide transition-colors duration-200 ${
            currentPath === link.href || currentPath.startsWith(link.href + '/')
              ? 'text-terracotta'
              : 'text-nero hover:text-terracotta'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <button
      class="md:hidden flex flex-col gap-[5px] p-2"
      aria-label="Menu"
      id="menu-toggle"
    >
      <span class="block w-5 h-[0.5px] bg-nero"></span>
      <span class="block w-5 h-[0.5px] bg-nero"></span>
      <span class="block w-5 h-[0.5px] bg-nero"></span>
    </button>
  </div>

  <div class="md:hidden hidden bg-bianco border-t px-6 py-4 space-y-3" style="border-color: #D8C7B8; border-width: 0.5px;" id="mobile-menu">
    <a href="/" class="block text-sm text-nero hover:text-terracotta transition-colors py-1">Homepage</a>
    <a href="/blog" class="block text-sm text-nero hover:text-terracotta transition-colors py-1">Blog</a>
    <a href="/about" class="block text-sm text-nero hover:text-terracotta transition-colors py-1">About</a>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle.addEventListener('click', () => {
    menu.classList.toggle('hidden');
  });

  menu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
    });
  });
</script>
