---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/glossario', label: 'Glossario' },
  { href: '/newsletter', label: 'Newsletter' },
  { href: '/about', label: 'About' },
];
---

<header class="sticky top-0 z-50 bg-bianco border-b" style="border-color: #D8C7B8; border-width: 0.5px;">
  <div class="max-w-content mx-auto px-6 md:px-10 flex items-center justify-between h-16">

    <!-- Logo -->
    <a href="/" class="flex flex-col leading-none group" aria-label="TRAMA Studio — Homepage">
      <span class="logo-trama text-xl text-nero group-hover:text-terracotta transition-colors duration-200">TRAMA</span>
      <span class="logo-studio text-[9px] mt-[1px]">studio</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`font-inter font-400 text-sm tracking-wide transition-colors duration-200 ${
            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href + '/'))
              ? 'text-terracotta'
              : 'text-nero hover:text-terracotta'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Hamburger button (mobile only) -->
    <button
      id="menu-toggle"
      class="md:hidden text-2xl leading-none p-2 text-nero"
      aria-label="Apri menu"
      aria-expanded="false"
      type="button"
    >
      ☰
    </button>

  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden w-full flex-col py-6 px-6 space-y-5"
    style="background-color: #111111;"
  >
    {navLinks.map(link => (
      <a
        href={link.href}
        class="block text-base font-inter tracking-wide transition-colors duration-200"
        style="color: #F5F1EA;"
      >
        {link.label}
      </a>
    ))}
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var toggle = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    if (toggle && menu) {
      toggle.addEventListener('click', function () {
        var isOpen = !menu.classList.contains('hidden');
        if (isOpen) {
          menu.classList.add('hidden');
          menu.classList.remove('flex');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.textContent = '☰';
        } else {
          menu.classList.remove('hidden');
          menu.classList.add('flex');
          toggle.setAttribute('aria-expanded', 'true');
          toggle.textContent = '✕';
        }
      });
      menu.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () {
          menu.classList.add('hidden');
          menu.classList.remove('flex');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.textContent = '☰';
        });
      });
    }
  });
</script>
